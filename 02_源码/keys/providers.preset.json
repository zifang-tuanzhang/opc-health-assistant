      "wire": "openai",
      "homepage": "https://platform.deepseek.com/",
      "doc": "https://api-docs.deepseek.com/zh-cn/guides/",
      "models": ["deepseek-chat", "deepseek-reasoner"],
      "default_model": "deepseek-chat",
      "note": "国内直连稳定、无需代理；按 token 计费，性价比高。"
    },
