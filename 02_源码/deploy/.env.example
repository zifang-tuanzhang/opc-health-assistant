# OPC 接单吧·AI 医院资源查询与便民就医助手 · 环境变量示例
# 说明：本文件全部为「可选」项。零配置即可启动，以「骨架模式」运行（不接模型、仍可真联网检索）。
#       复制为 deploy/.env 或 src/.env 后按需填写；切勿把真实 Key 提交进版本库 / 打进交付包。
#
# 密钥路径优先级（重要）：
#   主路径 = 网页「添加密钥」→ 写入【外部密钥库】(%USERPROFILE%\.opc_health\keys.json)，不进仓库；
#   回落路径 = 下面的 OPC_LLM_* 环境变量，供容器 / CI / 无用户目录场景使用。二者同时存在时密钥库优先。

# ── 运行环境 ──
OPC_ENV=dev
OPC_HOST=0.0.0.0
OPC_PORT=8137

# ── 演示城市（编排参数：默认检索范围；模型仍可处理其他城市，非硬编码答案）──
OPC_DEMO_CITY=昆明

# ── 免密钥搜索后端回退顺序（本届核心：真联网检索，严禁硬编码答案冒充查询）──
# 取值：so360 （360搜索【桌面版】，国内可达、返回【文章级】真实来源 URL，默认首选）/
#       mso360（360搜索【移动版】，同引擎不同入口，返回【文章级】真实来源 URL + 发布日期。
#              桌面版被风控时移动版仍可用，作为额外回退。注意：是"提高上限"不是"免疫"，
#              持续高频下两个入口会先后被风控）/
#       sogou （搜狗搜索，国内可达、返回【域名级】真实来源 URL + 发布日期，第三兜底）/
#       sm    （神马搜索【移动版】，国内可达、返回【文章级】真实来源 URL，第四兜底）。
# 按顺序回退，首个有结果的后端胜出；全部失败返回空，由「诚实护栏」兜底（不编造）。
# 注：引擎被高频请求时会返回「HTTP 200 的安全验证页」，检索层会统一识别并判该后端
#     失败（否则会把验证页当结果解析，产出编造来源）。
# ddg（DuckDuckGo lite）**默认不启用**：国内不可达，每次要白等满超时；仅一个 ddg 就能让
#     单次查询多耗 ~24 秒（端到端实测 62.9 秒）。需要时显式加回。
OPC_SEARCH_BACKENDS=so360,mso360,sogou,sm

# 检索总耗时预算（秒）：无论上面怎么配，单次检索的外呼总耗时不超此值。0 = 不限制（不推荐）。
OPC_SEARCH_BUDGET_SECONDS=18

# ── 模型 API 回落位（主路径是外部密钥库，这里是它的回落位）──
# OPC_LLM_API_KEY 为触发条件；BASE_URL 缺省用 OpenAI 官方地址。三个都留空 = 骨架模式。
OPC_LLM_API_KEY=
OPC_LLM_BASE_URL=
OPC_LLM_MODEL=

# ── 反射式护栏（Loop Controller）──
# 最多打回轮数：产出不通过校验时编码回灌模型令其重新生成（不重新检索）。
OPC_GUARDRAIL_MAX_REFLECT=2
# R3 来源可达校验：默认关（开启需联网探测链接，弱网下易假阳性）。
OPC_GUARDRAIL_VERIFY_URLS=0

# ── LLM 运行保障（赛题「进阶3」：成本记录 / 缓存去重 / 限速）──
# 每日 token 预算，超限返回明确降级码（不崩溃）。
OPC_LLM_DAILY_BUDGET_TOKENS=1000000
# 相同请求缓存 TTL（秒），0 表示关闭缓存。
OPC_LLM_CACHE_TTL_SECONDS=86400
# 每分钟模型调用上限。注意一轮对话内部可能调用 2~3 次（分析→生成→打回重整），
# 故默认 30（约 10 轮/分钟），既防死循环又不会让使用者连续提问时被误挡。
OPC_LLM_RATE_LIMIT_PER_MIN=30

# ── 网关边界（输入护栏：空 / 超长 / 限流）──
OPC_MAX_MESSAGE_LEN=500
OPC_RATE_LIMIT_PER_MIN=300

# ── CORS 白名单（逗号分隔；prod 禁用 *）──
# OPC_CORS_ORIGINS=http://127.0.0.1:8137,http://localhost:8137
